.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Local git worktrees used to inspect teammates' branches. These are separate
# checkouts, not project content; committing one embeds a repo inside the repo.
.worktrees/

# Model weights live on D:\models, never in the repo.
*.gguf

# Eval outputs are regenerated. Ignore the directory CONTENTS, not the
# directory itself -- git does not descend into an ignored directory, so
# `eval/out/` + `!eval/out/.gitkeep` would silently drop the negation.
# The two result files below are committed on purpose: they are the evidence
# behind the numbers quoted in the README.
eval/out/*
!eval/out/.gitkeep
!eval/out/baseline-local.json
!eval/out/harness-local.json
# Evidence behind the curated-vs-discovered comparison.
!eval/out/baseline-local-r2.json
!eval/out/harness-local-curated.json
!eval/out/harness-local-discovered.json
!eval/out/harness-local-discovered-v2.json
# Re-measurement after the false-pass fix (2026-09-19), quoted in the README.
!eval/out/harness-local-postfix-curated.json
!eval/out/harness-local-postfix-discovered.json
# Yingzi's 35-question local evaluation and its provenance.
!eval/out/baseline-local-yingzi-20260919.json
!eval/out/harness-local-yingzi-20260919.json
!eval/out/dry-gold-yingzi-20260919.json
!eval/out/yingzi-20260919-metadata.json
!eval/out/yingzi-20260919-report.md
!eval/out/yingzi-20260919.log

# The milk-tea dataset writes to its own results directory. Unignore the
# directory first -- git never descends into an ignored directory, so the
# negations below would not be seen otherwise -- then re-ignore its contents
# and keep only the committed milk-tea evaluation.
!eval/out/milk_tea/
eval/out/milk_tea/*
!eval/out/milk_tea/baseline-local-milk-tea-20260919.json
!eval/out/milk_tea/harness-local-milk-tea-20260919.json
!eval/out/milk_tea/dry-gold-milk-tea-20260919.json
!eval/out/milk_tea/milk-tea-20260919-metadata.json
!eval/out/milk_tea/milk-tea-20260919-report.md
!eval/out/milk_tea/milk-tea-20260919.log

# Same shape for the mixed five-industry dataset: unignore the directory, then
# re-ignore its contents and keep only the committed evaluation.
!eval/out/mixed/
eval/out/mixed/*
!eval/out/mixed/baseline-local-mixed-20260919.json
!eval/out/mixed/harness-local-mixed-20260919.json
!eval/out/mixed/dry-gold-mixed-20260919.json
!eval/out/mixed/mixed-20260919-metadata.json
!eval/out/mixed/mixed-20260919-report.md
!eval/out/mixed/mixed-20260919.log

.DS_Store
Thumbs.db
.idea/
.vscode/
